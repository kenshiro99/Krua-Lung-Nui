# ==============================================================================
# Krua Lung Nui - .gitignore
# Prevents large archives, private keys, and build artifacts from hitting GitHub
# ==============================================================================

# Big Archives & Backups (GitHub limits individual files to < 100MB)
*.zip
*.tar.gz
*.rar
*.7z

# Local Secrets & Credentials
.env
.env.local


# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.bak
*.tmp
.agents/
test_results.json

